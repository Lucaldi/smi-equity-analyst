# Kopieren nach .env und Werte eintragen. .env nie committen.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FINNHUB_API_KEY=
TAVILY_API_KEY=              # News von Qualitätsmedien; leer = nur yfinance

# LLM für Agenten
LLM_PROVIDER=openai          # openai | anthropic
LLM_MODEL=gpt-4o-mini

# Sentiment im News-Agent (kein Training, nur Inferenz)
SENTIMENT_BACKEND=llm               # llm (Standard) | finbert
SENTIMENT_LLM_PROVIDER=openai       # openai | anthropic
SENTIMENT_LLM_MODEL=                # leer = LLM_MODEL
FINBERT_MODEL=ProsusAI/finbert

# Cache für Docling-Ergebnisse und Sentiment-Vorhersagen (JSON)
CACHE_DIR=data/cache
