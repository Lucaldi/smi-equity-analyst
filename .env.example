# Kopieren nach .env und Werte eintragen. .env nie committen.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FINNHUB_API_KEY=

# LLM für Agenten
LLM_PROVIDER=openai          # openai | anthropic
LLM_MODEL=gpt-4o-mini

# Sentiment-Variante im News-Agent: tfidf | finbert | llm
SENTIMENT_BACKEND=finbert
SENTIMENT_MODEL_PATH=models/finbert-finetuned
